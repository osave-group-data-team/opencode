{
  "$schema": "https://opencode.ai/config.json",
"model": "osave-dashboard-wc-us/FW-DeepSeek-V4-Pro",
  "enabled_providers": [
    "osave-dashboard-main",
    "osave-dashboard-e-us",
    "osave-dashboard-e-us-2",
    "osave-dashboard-wc-us",
    "osave-dashboard-c-us"
  ],
  "share": "disabled",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 65536,
    "tail_turns": 3,
    "preserve_recent_tokens": 32768
  },
  "provider": {
    "osave-dashboard-main": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OSave Dashboard Main",
      "env": ["OSAVE_DASHBOARD_MAIN_API_KEY"],
      "options": {
        "baseURL": "http://127.0.0.1:8787/openai/v1",
        "timeout": 600000,
        "headerTimeout": 120000,
        "chunkTimeout": 60000
      },
      "models": {
        "DeepSeek-V4-Pro": {
          "name": "DeepSeek-V4-Pro",
          "reasoning": true, "temperature": true, "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] },
          "limit": { "context": 1048576, "output": 32768 },
          "options": { "reasoning_effort": "max" },
          "variants": {
            "high": { "reasoning_effort": "max" },
            "medium": { "reasoning_effort": "max" }
          }
        },
        "DeepSeek-V4-Flash": {
          "name": "DeepSeek-V4-Flash",
          "reasoning": true, "temperature": true, "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] },
          "limit": { "context": 1048576, "output": 32768 },
          "options": { "reasoning_effort": "low" }
        },
        "Kimi-K2.7-Code": {
          "name": "Kimi-K2.7-Code",
          "reasoning": true, "temperature": true, "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] },
          "limit": { "context": 262144, "output": 16384 },
          "options": { "reasoning_effort": "high" }
        }
      }
    },
    "osave-dashboard-e-us": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OSave Dashboard E US",
      "env": ["OSAVE_DASHBOARD_E_US_API_KEY"],
      "options": {
        "baseURL": "http://127.0.0.1:8787/openai/v1",
        "timeout": 600000, "headerTimeout": 120000, "chunkTimeout": 60000
      },
      "models": {
        "FW-DeepSeek-V4-Pro": {
          "name": "FW-DeepSeek-V4-Pro",
          "reasoning": true, "temperature": true, "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] },
          "limit": { "context": 1048576, "output": 32768 },
          "options": { "reasoning_effort": "max" }
        }
      }
    },
    "osave-dashboard-e-us-2": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OSave Dashboard E US 2",
      "env": ["OSAVE_DASHBOARD_E_US_2_API_KEY"],
      "options": {
        "baseURL": "http://127.0.0.1:8787/openai/v1",
        "timeout": 600000, "headerTimeout": 120000, "chunkTimeout": 60000
      },
      "models": {
        "FW-Kimi-K2.7-Code": {
          "name": "FW-Kimi-K2.7-Code",
          "reasoning": true, "temperature": true, "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] },
          "limit": { "context": 262144, "output": 16384 },
          "options": { "reasoning_effort": "high" }
        }
      }
    },
    "osave-dashboard-wc-us": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OSave Dashboard WC US",
      "env": ["OSAVE_DASHBOARD_WC_US_API_KEY"],
      "options": {
        "baseURL": "http://127.0.0.1:8787/openai/v1",
        "timeout": 600000, "headerTimeout": 120000, "chunkTimeout": 60000
      },
      "models": {
        "FW-DeepSeek-V4-Pro": {
          "name": "FW-DeepSeek-V4-Pro",
          "reasoning": true, "temperature": true, "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] },
          "limit": { "context": 1048576, "output": 32768 },
          "options": { "reasoning_effort": "high" }
        }
      }
    },
    "osave-dashboard-c-us": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OSave Dashboard C US",
      "env": ["OSAVE_DASHBOARD_C_US_API_KEY"],
      "options": {
        "baseURL": "http://127.0.0.1:8787/openai/v1",
        "timeout": 600000, "headerTimeout": 120000, "chunkTimeout": 60000
      },
      "models": {
        "FW-Kimi-K2.7-Code": {
          "name": "FW-Kimi-K2.7-Code",
          "reasoning": true, "temperature": true, "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] },
          "limit": { "context": 262144, "output": 16384 },
          "options": { "reasoning_effort": "high" }
        }
      }
    }
  },
  "permission": {
    "edit": {
      "*": "deny",
      ".claude/worktrees/**": "ask",
      "**/.opencode/**": "ask",
      "**/AGENTS.md": "ask",
      "~/.config/opencode/**": "ask"
    },
    "read": {
      "*": "ask",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env*": "deny",
      "**/secrets/**": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.pfx": "deny",
      "**/*.p12": "deny",
      "**/credentials.json": "deny",
      "**/secrets.json": "deny",
      "**/.azure/**": "deny",
      "**/.fabric/**": "deny",
      "**/.fab/**": "deny",
      "**/.ssh/**": "deny",
      "**/.gnupg/**": "deny",
      "**/.aws/**": "deny",
      "**/.kube/**": "deny",
      "**/.npmrc": "deny",
      "**/.netrc": "deny",
      "**/.git-credentials": "deny",
      "**/.config/gh/hosts.yml": "deny",
      "**/.codex/auth.json": "deny",
      "**/opencode/auth.json": "deny"
    },
    "bash": {
      "*": "ask",
      "git reset --hard*": "deny",
      "git clean *-f*": "deny",
      "git checkout -- *": "deny",
      "git restore *": "deny",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "env": "deny",
      "env *": "deny",
      "printenv": "deny",
      "printenv *": "deny"
    },
    "glob": "ask",
    "grep": "ask",
    "list": "ask",
    "task": "ask",
    "external_directory": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "lsp": "ask",
    "doom_loop": "ask",
    "skill": "ask"
  },
  "tool_output": {
    "max_lines": 4000,
    "max_bytes": 102400
  },
  "experimental": {
    "mcp_timeout": 30000
  },
  "autoupdate": false,
  "agent": {
    "general":  { "model": "osave-dashboard-wc-us/FW-DeepSeek-V4-Pro", "variant": "medium" },
    "explore":  { "model": "osave-dashboard-c-us/FW-Kimi-K2.7-Code", "variant": "high" },
    "build":    { "model": "osave-dashboard-wc-us/FW-DeepSeek-V4-Pro", "variant": "high" },
    "plan":     { "model": "osave-dashboard-wc-us/FW-DeepSeek-V4-Pro", "variant": "high" },
    "review":   { "model": "osave-dashboard-c-us/FW-Kimi-K2.7-Code", "variant": "high" },
    "compaction": { "model": "osave-dashboard-c-us/FW-Kimi-K2.7-Code", "variant": "high" },
    "title":    { "model": "osave-dashboard-c-us/FW-Kimi-K2.7-Code", "variant": "high" },
    "summary":  { "model": "osave-dashboard-c-us/FW-Kimi-K2.7-Code", "variant": "high" }
  }
}
